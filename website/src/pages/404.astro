---
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Page not found — Statepack</title>
    <meta name="theme-color" content="#09050f" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;550;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <main class="not-found">
      <p class="eyebrow">STATEPACK / 404</p>
      <h1>Page not found.</h1>
      <a class="btn-primary" href="/">
        Return to the playground →
      </a>
    </main>
  </body>
</html>
