---
import Playground from "../components/Playground";
import Shader from "../components/Shader";
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f4f2ed" />
    <meta
      name="description"
      content="Behavior, packed as data. Define state machines in JSON, run them anywhere, and explore Statepack in a live playground."
    />
    <title>Statepack — Behavior, packed as data.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#playground">
      Skip to playground
    </a>
    <header class="site-header">
      <a class="wordmark" href="#" aria-label="Statepack home">
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3z" fill="currentColor" />
          <path d="m13 17 4-4 4 4-4 4z" fill="currentColor" />
        </svg>
        statepack<span class="brand-dot">*</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#playground">Playground</a>
        <a href="#how-it-works">How it works</a>
        <a
          href="https://github.com/cristianmartinez/statepack"
          target="_blank"
          rel="noopener"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-heading">
          <p class="eyebrow">
            <span class="signal-dot"></span> A STATE MACHINE YOU CAN PACK
          </p>
          <h1 id="hero-title">
            Behavior,
            <br />
            packed as <span class="serif">data.</span>
          </h1>
          <p class="hero-copy">
            Define the states. Connect the events.
            <br />
            Keep the whole thing in JSON.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#playground">
              Take it for a spin <span aria-hidden="true">↓</span>
            </a>
            <a
              class="text-link"
              href="https://github.com/cristianmartinez/statepack/tree/main/packages/state-machine"
              target="_blank"
              rel="noopener"
            >
              Read the source <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="hero-footnote">
            TYPESCRIPT RUNTIME <span>·</span> JSON DEFINITIONS <span>·</span>{" "}
            JSONATA EXPRESSIONS
          </p>
        </div>
        <div class="hero-art">
          <Shader client:visible />
          <div class="art-grid"></div>
          <div class="art-label">FIG. 001 / A CHANGE OF STATE</div>
          <svg aria-hidden="true" class="art-machine" viewBox="0 0 500 450">
            <defs>
              <marker
                id="art-arrow"
                markerWidth="8"
                markerHeight="8"
                refX="6"
                refY="4"
                orient="auto"
              >
                <path
                  d="M0 0 8 4 0 8"
                  fill="none"
                  stroke="#292d22"
                  stroke-width="1"
                />
              </marker>
            </defs>
            <path
              d="M123 194C157 119 327 119 367 194"
              class="art-path"
              marker-end="url(#art-arrow)"
            />
            <path
              d="M367 270C327 345 157 345 123 270"
              class="art-path"
              marker-end="url(#art-arrow)"
            />
            <text x="245" y="133" class="art-caption">
              EVENT
            </text>
            <text x="245" y="343" class="art-caption">
              EVENT
            </text>
            <circle cx="123" cy="233" r="51" class="art-node" />
            <circle
              cx="123"
              cy="233"
              r="42"
              fill="none"
              stroke="#303829"
              stroke-dasharray="2 5"
            />
            <text x="123" y="238" class="art-state">
              idle
            </text>
            <circle cx="367" cy="233" r="51" class="art-node active" />
            <text x="367" y="238" class="art-state">
              active
            </text>
            <circle cx="367" cy="307" r="3" fill="#272d22" />
            <path
              d="M367 312v45h-95"
              stroke="#353b2c"
              fill="none"
              stroke-width="1"
            />
            <text x="260" y="363" text-anchor="end" class="art-small">
              SAME DEFINITION. NEW STATE.
            </text>
          </svg>
          <div class="art-bottom">
            <span>01 → 02</span>
            <span>STATE / TRANSITION / REPEAT</span>
          </div>
        </div>
      </section>
      <div class="section-divider">
        <span>LESS GLUE CODE. MORE EXPLICIT BEHAVIOR.</span>
        <span>
          SCROLL TO EXPLORE <span aria-hidden="true">↓</span>
        </span>
      </div>
      <section
        id="playground"
        class="playground-section"
        aria-labelledby="playground-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / THE PLAYGROUND</p>
            <h2 id="playground-title">
              A little machine.
              <br />
              <span class="serif">A lot you can do.</span>
            </h2>
          </div>
          <p>
            Send an event. Watch the state change.
            <br />
            Then edit the definition and make it yours.
          </p>
        </div>
        <Playground client:load />
        <p class="playground-note">
          The definition is plain data. The behavior is what you make of it.
        </p>
      </section>
      <section
        class="explanation"
        id="how-it-works"
        aria-labelledby="how-title"
      >
        <div class="explanation-intro">
          <p class="eyebrow">02 / UNDER THE HOOD</p>
          <h2 id="how-title">
            Write it once.
            <br />
            <span class="serif">Keep it portable.</span>
          </h2>
          <p>
            States, transitions, guards, and mutations live in one definition.
            The runtime handles the next step.
          </p>
          <a
            href="https://github.com/cristianmartinez/statepack/blob/main/packages/state-machine/README.md"
            class="text-link"
            target="_blank"
            rel="noopener"
          >
            Explore the API <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="explanation-steps">
          <article>
            <span class="step-number">01</span>
            <div>
              <h3>Define in JSON</h3>
              <p>
                Describe what can happen. Store your machine alongside the rest
                of your data.
              </p>
              <code>
                &#123; "initial": "idle", "states": &#123; … &#125; &#125;
              </code>
            </div>
          </article>
          <article>
            <span class="step-number">02</span>
            <div>
              <h3>Compile the expressions</h3>
              <p>
                JSONata handles dynamic values. Compile the definition before
                you run it.
              </p>
              <code>const compiled = compileMachine(machine);</code>
            </div>
          </article>
          <article>
            <span class="step-number">03</span>
            <div>
              <h3>Let events move it</h3>
              <p>
                Send events to the interpreter. Read the current state and
                reactive store values.
              </p>
              <code>await interpreter.send("TOGGLE");</code>
            </div>
          </article>
        </div>
      </section>
      <section class="closing">
        <p class="eyebrow">SMALL PARTS. EXPLICIT RULES.</p>
        <h2>
          Your logic deserves
          <br />
          <span class="serif">a place to live.</span>
        </h2>
        <a
          class="button primary"
          href="https://github.com/cristianmartinez/statepack"
          target="_blank"
          rel="noopener"
        >
          Build with Statepack <span aria-hidden="true">↗</span>
        </a>
        <div class="closing-mark" aria-hidden="true">
          &#123; &#125;
        </div>
      </section>
    </main>
    <footer>
      <a class="wordmark" href="#">
        statepack
      </a>
      <p>Behavior, packed as data.</p>
      <a
        href="https://github.com/cristianmartinez/statepack"
        target="_blank"
        rel="noopener"
      >
        Source on GitHub <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </body>
</html>
