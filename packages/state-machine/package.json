{
  "name": "@ouni/state-machine",
  "version": "0.0.1",
  "description": "XState-inspired declarative state machine for mini-apps",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun build ./src/index.ts --outdir ./dist --target browser --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ouni/conditions": "workspace:*",
    "@ouni/data": "workspace:*",
    "@ouni/expressions": "workspace:*",
    "@preact/signals-core": "^1.12.1",
    "zod": "3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
